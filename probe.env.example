# Run the same Docker image as a separate Amvera application.
APP_MODULE=probe.main:app
PORT=80

TOURVISOR_API_BASE_URL=https://api.tourvisor.ru
TOURVISOR_JWT=

# Protect every probe start/result endpoint. Use a long random value.
PROBE_TOKEN=

# Connection/setup timeout. Read timeout is chosen per probe job, up to the max below.
PROBE_CONNECT_TIMEOUT_SECONDS=10
PROBE_PREFLIGHT_TIMEOUT_SECONDS=20
PROBE_MAX_READ_TIMEOUT_SECONDS=300

# Safety guard: at most this many billable /flights calls in one process lifetime.
PROBE_MAX_BILLABLE_JOBS_PER_PROCESS=5
PROBE_JOB_HISTORY_LIMIT=20
LOG_LEVEL=INFO
